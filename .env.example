# Supabase — obtener en: Project Settings → Database → Connection string → URI
# Usar el "Session mode" pooler (puerto 5432) para desarrollo
# Usar el "Transaction mode" pooler (puerto 6543) para producción en Vercel
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_tambien

PORT=3001
NODE_ENV=development
